# 📄 .env.example
# =============================================================================
# CDC Manager — Centro Dentário Colombo | Variáveis de Ambiente
# =============================================================================
# Copiar para .env.local e preencher. NUNCA commitar o .env.local.
# Em produção, definir todas no painel da Vercel (Settings > Environment Variables).
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# URL base da aplicação (produção: https://app.centrodentariocolombo.com — a definir)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MONGODB (Atlas)
# -----------------------------------------------------------------------------
# Cluster dedicado ao CDC Manager. Criar utilizador próprio com role readWrite.
MONGODB_URI=

# -----------------------------------------------------------------------------
# NEXTAUTH v5
# -----------------------------------------------------------------------------
# Gerar com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
# Em produção na Vercel é detetado automaticamente; em dev:
AUTH_URL=http://localhost:3000
# Confiar no host (necessário para NextAuth v5 atrás de proxy/Vercel)
AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# CLOUDINARY (exames, RX, documentos, consentimentos assinados)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pasta raiz dos uploads do projeto
CLOUDINARY_FOLDER=cdc-manager

# -----------------------------------------------------------------------------
# RESEND (e-mails transacionais)
# -----------------------------------------------------------------------------
# Domínio a verificar no Resend: send.centrodentariocolombo.com (DKIM + SPF)
RESEND_API_KEY=
EMAIL_FROM="Centro Dentário Colombo <noreply@send.centrodentariocolombo.com>"

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS CLOUD API (Meta) — Sprint 6
# -----------------------------------------------------------------------------
# Número NOVO dedicado (nunca registado no WhatsApp comum). Criar app em
# developers.facebook.com > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token permanente (System User token, não o token temporário de 24h)
WHATSAPP_ACCESS_TOKEN=
# String secreta inventada por nós — tem de ser igual à configurada no webhook da Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret (validação de assinatura X-Hub-Signature-256 dos webhooks)
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# SMS — fallback (Twilio) — Sprint 6
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# MOLONI (faturação certificada AT) — Sprint 4
# -----------------------------------------------------------------------------
# Conta nova da clínica. Criar app de developer em moloni.pt > Developers.
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_USERNAME=
MOLONI_PASSWORD=
MOLONI_COMPANY_ID=

# -----------------------------------------------------------------------------
# PUSHER (tempo real: fila de cobrança, agendas ao vivo)
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_SECRET=
# As NEXT_PUBLIC_* são expostas ao browser (necessário para subscrever canais)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# -----------------------------------------------------------------------------
# CRON (Vercel Cron) — proteção dos endpoints
# -----------------------------------------------------------------------------
# Gerar string aleatória. A Vercel envia como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# -----------------------------------------------------------------------------
# SEED (scripts locais: npx tsx src/lib/seed/run.ts)
# -----------------------------------------------------------------------------
# E-mail e password do primeiro admin criado pelo seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=