+            fontSize: '13px',
+            fontWeight: 600,
+            color: '#FFFFFF',
+            backgroundColor: 'transparent',
+            cursor: 'pointer',
+          }}
+        >
+          Sair
+        </button>
+      </form>
     </div>
   );
+
+  return (
+    <AppShell
+      area='doutor'
+      brand={brand}
+      topbar={topbar}
+      topbarOnMobile={false}
+      drawerFooter={drawerFooter}
+    >
+      {children}
+    </AppShell>
+  );
 }
